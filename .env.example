# --- Supabase -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# --- AI -------------------------------------------------------------------
ANTHROPIC_API_KEY=
# Defaults to claude-opus-5-5 when empty.
ANTHROPIC_MODEL=
# "live" = real Claude calls, "mock" = clearly labelled deterministic fixtures.
AI_MODE=mock

# --- Email (Resend) -------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# --- SMS & voice (Twilio) -------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Operations -----------------------------------------------------------
# Bearer secret Vercel Cron sends to /api/cron/escalations.
CRON_SECRET=
# Enables the demo control centre and keeps secure links visible in the
# SIMULATED outbox (only for simulated messages). Set to false in production.
DEMO_TOOLS_ENABLED=true
